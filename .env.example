# Example environment variables for local development
# Copy this file to .env.local (which is gitignored) and fill your secrets.

# Hugging Face token used by pyannote (do NOT commit to git)
# Get your token from https://huggingface.co/settings/tokens
PYANNOTE_TOKEN=

# Example: set to 'cuda' if you have a GPU
DIAR_DEVICE=cpu

# Optional: tune thread budget
POST_THREADS=8
